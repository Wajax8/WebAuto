generator client {
  provider = "prisma-client-js"
}

ddatasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Car {
  id         String @id @default(cuid())
  brand      String
  model      String
  generation String?
  hp         Int?
  weight     Int?
  color      String?
  userId     String
}
